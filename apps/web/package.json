{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lava/shared build && next build",
    "dev": "pnpm --filter @lava/shared build && next dev",
    "test": "vitest run",
    "typecheck": "pnpm --filter @lava/shared build && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck"
  },
  "dependencies": {
    "@lava/shared": "workspace:*",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.0.0"
  }
}
