NEXT_PUBLIC_API_BASE_URL=
DATABASE_URL=postgresql://lava:lava@localhost:5432/lava
JWT_SECRET=dev-only
COOKIE_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PUBLIC_URL=http://localhost:3000 # 이메일 등에 사용될 대표 공개 프론트엔드 도메인 (배포 환경에서 필수 설정)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=60000
# gpt-5 계열 reasoning effort. 기본 minimal이면 응답이 크게 빨라져 타임아웃/503을 예방한다. (minimal|low|medium|high)
OPENAI_REASONING_EFFORT=minimal
# reasoning 토큰이 출력 예산을 다 먹어 빈 응답(503)이 나오지 않도록 충분히 확보한다.
OPENAI_MAX_OUTPUT_TOKENS=8000
# 일시적 429/5xx/타임아웃 자동 재시도 횟수
OPENAI_MAX_RETRIES=2
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
